/*
static void PrintField(int depth, const std::string& key, const std::string& value)
{
    std::printf("%*s\"%s\": %s,\n", 2 * depth, "", key.c_str(), value.c_str());
}

static void PrintField(int depth, const std::string& key, int64_t value)
{
    PrintField(depth, key, strprintf("%d", value));
}

static std::string Quoted(const std::string& text) { return "\"" + text + "\""; }

static std::string Flag(bool flag) { return flag ? "true" : "false"; }

static std::string Pair(int height, const uint256& hash) { return strprintf("[%d, \"%s\"]", height, hash.GetHex()); }

static std::string Rate(double rate)
{
    char buf[32];
    for (int precision = 1;; ++precision) {
        std::snprintf(buf, sizeof(buf), "%.*g", precision, rate);
        if (std::strtod(buf, nullptr) == rate) return buf;
    }
}

static std::string List(const std::vector<std::string>& items)
{
    std::string list;
    for (const std::string& item : items) {
        list += (list.empty() ? "" : ", ") + Quoted(item);
    }
    return "[" + list + "]";
}

static std::string LLMQName(Consensus::LLMQType type)
{
    for (const auto& llmq : Consensus::available_llmqs) {
        if (llmq.type == type) return Quoted(std::string{llmq.name});
    }
    return Quoted("none");
}

static void PrintDeployment(const std::string& name, const Consensus::BIP9Deployment& dep)
{
    std::printf("          \"%s\": {\n", name.c_str());
    PrintField(6, "bit", dep.bit);
    PrintField(6, "start_time", dep.nStartTime);
    PrintField(6, "timeout", dep.nTimeout);
    PrintField(6, "min_activation_height", dep.min_activation_height);
    PrintField(6, "window_size", dep.nWindowSize);
    PrintField(6, "threshold_start", dep.nThresholdStart);
    PrintField(6, "threshold_min", dep.nThresholdMin);
    PrintField(6, "falloff_coeff", dep.nFalloffCoeff);
    PrintField(6, "use_ehf", Flag(dep.useEHF));
    std::printf("          },\n");
}

