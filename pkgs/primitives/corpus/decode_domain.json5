// Byte strings Dash Core decodes (or rejects while decoding), for the decode
// domain of base-sdk's primitives. Each section names its source. "core" is
// what Core does with the bytes, checked against v23.1.8 and v24.0.0-rc.3
// by calling Core's own CTransaction deserialization, then CheckTransaction,
// in a test program linked against unmodified builds of both tags.
{
  // Dash Core src/test/data/tx_invalid.json, "Tests for CheckTransaction()",
  // identical at v23.1.8 and v24.0.0-rc.3. transaction_tests.cpp deserializes
  // each and expects CheckTransaction to fail; Core decodes all bytes and
  // rejects with "core".
  "tx_value_range": [
    {
      "name": "negative_output",
      "raw": "",
      "values": [-1],
      "core": "bad-txns-vout-negative",
    },
    {
      "name": "max_money_plus_1",
      "raw": "",
      "values": [2100000000000001],
      "core": "bad-txns-vout-toolarge",
    },
    {
      "name": "max_money_output_plus_1_output",
      "raw": "",
      "values": [2100000000000000, 256],
      "core": "bad-txns-txouttotal-toolarge",
    },
  ],
  // Mainnet CbTx ac9fc5d0... (block 000000000000003bb55596232b23ffe0dd9f88b8d1c5cc4123184a61b132dafa,
  // section "cbtx" of cbtx.json5) with its extra payload zero-padded to
  // "payload_len" bytes. Core reads vExtraPayload as a std::vector, so any
  // length up to MAX_SIZE decodes and CheckTransaction enforces the limits;
  // one byte more fails in ReadCompactSize ("size too large").
  "tx_payload_size": [
    { "payload_len": 10000, "core": "accept" },
    { "payload_len": 10001, "core": "bad-txns-payload-oversize" },
    { "payload_len": 10241, "core": "bad-txns-payload-oversize" },
    { "payload_len": 1000000, "core": "bad-txns-oversize" },
    { "payload_len": 33554432, "core": "bad-txns-oversize" },
    { "payload_len": 33554433, "core": "decode: ReadCompactSize(): size too large" },
  ],
  // Real mainnet special transactions (from the named corpus file and
  // section) with "trailing" zero bytes appended to the extra payload. At
  // v23.1.8 and v24.0.0-rc.3, decoderawtransaction decodes each transaction
  // but omits the payload object, because GetTxPayload returns nullopt when
  // its stream is not empty after the payload.
  "payload_trailing": [
    {
      "corpus": "proregtx",
      "txid": "a9e25c9aa56874c5703fc78ce8541364560d5b21eb12812cf452a27776b1f840",
      "trailing": 1,
    },
    {
      "corpus": "cbtx",
      "txid": "ac9fc5d0c7229a1c9fb834d8c6f6be200ae5b55d1b731c38afd83adc0c54aa31",
      "trailing": 1,
    },
  ],
  // A ProUpServTx v3 on the inputs and outputs of the proregtx corpus
  // transaction a9e25c9a..., its NetInfo listing purposes 2, 0 and 2 again,
  // one IPv4 service each. At
  // v23.1.8 and v24.0.0-rc.3, decoderawtransaction prints "addresses" with
  // the first group of each purpose, in purpose order: Core reads a
  // std::map. The all-zero signature decodes as an invalid one.
  "netinfo_map": [
    {
      "raw": "",
      "core": { "core_p2p": ["5.6.7.8:2"], "platform_https": ["1.2.3.4:1"] },
    },
  ],
}
