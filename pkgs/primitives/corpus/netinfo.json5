  // Each vector reads one entry from `raw`. `read` counts the bytes read, `written` is the entry written back and `addr_port` its address and port. Fields other than `raw` are null when the read fails.
  "entry": [
    // An IPv4 service.
    { "raw": "01010401020304270f", "read": 9, "written": "01010401020304270f", "addr_port": "1.2.3.4:9999" },
    // An IPv6 service.
    { "raw": "01021026064700470000000000000000001111270f", "read": 21, "written": "01021026064700470000000000000000001111270f", "addr_port": "[2606:4700:4700::1111]:9999" },
    // An IPv6 service in fc00::/8 keeps network 2.
    { "raw": "010210fc000000000000000000000000000001270f", "read": 21, "written": "010210fc000000000000000000000000000001270f", "addr_port": "[fc00::1]:9999" },
    // A TORv3 service.
    { "raw": "01042079bcc625184b05194975c28b66b66b0469f7f6556fb1ac3189a79b40dda32f1f270f", "read": 37, "written": "01042079bcc625184b05194975c28b66b66b0469f7f6556fb1ac3189a79b40dda32f1f270f", "addr_port": "pg6mmjiyjmcrsslvykfwnntlaru7p5svn6y2ymmju6nubxndf4pscryd.onion:9999" },
    // An I2P service, on port 0.
    { "raw": "010520a2894dabaec08c0051a481a6dac88b64f98232ae42d4b6fd2fa81952dfe36a870000", "read": 37, "written": "010520a2894dabaec08c0051a481a6dac88b64f98232ae42d4b6fd2fa81952dfe36a870000", "addr_port": "ukeu3k5oycgaauneqgtnvselmt4yemvoilkln7jpvamvfx7dnkdq.b32.i2p:0" },
    // A CJDNS service.
    { "raw": "010610fc000000000000000000000000000001270f", "read": 21, "written": "010610fc000000000000000000000000000001270f", "addr_port": "[fc00::1]:9999" },
    // A domain.
    { "raw": "020b6578616d706c652e636f6d01bb", "read": 15, "written": "020b6578616d706c652e636f6d01bb", "addr_port": "example.com:443" },
    // A reserved top-level domain is kept; only the check refuses it.
    { "raw": "020a686f73742e6c6f63616c01bb", "read": 14, "written": "020a686f73742e6c6f63616c01bb", "addr_port": "host.local:443" },
    // A domain on a privileged port is kept; only the check refuses it.
    { "raw": "020b6578616d706c652e636f6d0050", "read": 15, "written": "020b6578616d706c652e636f6d0050", "addr_port": "example.com:80" },
    // A domain of 253 bytes, the longest that is read.
    { "raw": "", "read": 259, "written": "", "addr_port": "aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaaaaaaaa.aaa:443" },
    // A domain of 254 bytes is refused.
    { "raw": "", "read": null, "written": null, "addr_port": null },
    // A domain shorter than its length is refused.
    { "raw": "020b6578616d706c65", "read": null, "written": null, "addr_port": null },
    // A domain without its port is refused.
    { "raw": "020b6578616d706c652e636f6d", "read": null, "written": null, "addr_port": null },
    // An empty input is refused.
    { "raw": "", "read": null, "written": null, "addr_port": null },
    // Type 0 is not a type, so the entry is invalid.
    { "raw": "00", "read": 1, "written": "ff", "addr_port": "[invalid entry]" },
    // Type 3, after the domain type, is not a type either.
    { "raw": "03", "read": 1, "written": "ff", "addr_port": "[invalid entry]" },
    // Type 0xfe, below the invalid entry type, is not a type either.
    { "raw": "fe", "read": 1, "written": "ff", "addr_port": "[invalid entry]" },
    // The invalid entry type reads back as itself.
    { "raw": "ff", "read": 1, "written": "ff", "addr_port": "[invalid entry]" },
    // Only the type byte of an unknown type is read.
    { "raw": "03010401020304270f", "read": 1, "written": "ff", "addr_port": "[invalid entry]" },
    // A service at IPv4 0.0.0.0 is invalid.
    { "raw": "01010400000000270f", "read": 9, "written": "ff", "addr_port": "[invalid entry]" },
    // A service on an unknown network is invalid.
    { "raw": "01070401020304270f", "read": 9, "written": "ff", "addr_port": "[invalid entry]" },
    // A service at an IPv6 address with the TORv2 prefix is invalid.
    { "raw": "010210fd87d87eeb430102030405060708090a270f", "read": 21, "written": "ff", "addr_port": "[invalid entry]" },
    // A service that fails to read is an invalid entry.
    // https://github.com/dashpay/dash/blob/v24.0.0-rc.4/src/evo/netinfo.h#L247-L252
    // An IPv4 address size of 5 stops the read after the size.
    { "raw": "0101050102030405270f", "read": 3, "written": "ff", "addr_port": "[invalid entry]" },
    // An oversized address on an unknown network stops the read after its size.
    { "raw": "0107fd0102", "read": 5, "written": "ff", "addr_port": "[invalid entry]" },
    // An IPv4 address cut short stops the read after its size.
    { "raw": "010104010203", "read": 3, "written": "ff", "addr_port": "[invalid entry]" },
    // A short port stops the read before the port.
    { "raw": "0101040102030427", "read": 7, "written": "ff", "addr_port": "[invalid entry]" },
    // A domain with an uppercase letter is invalid.
    { "raw": "020b4578616d706c652e636f6d01bb", "read": 15, "written": "ff", "addr_port": "[invalid entry]" },
    // A domain on port 0 is invalid.
    { "raw": "020b6578616d706c652e636f6d0000", "read": 15, "written": "ff", "addr_port": "[invalid entry]" },
