    { "raw": "fd87d87eeb4300112233445566778899270f", "read": 18, "written": "000000000000000000000000000000000000", "entries": [], "empty": true },
    // An internal address is not valid.
    { "raw": "fd6b88c0872400112233445566778899270f", "read": 18, "written": "000000000000000000000000000000000000", "entries": [], "empty": true },
