  // Each vector reads the network info of a provider payload before version 3 from `raw`. `read` counts the bytes read, `written` is the value written back, `entries` the address and port of its entry and `empty` whether the value is empty. Fields other than `raw` are null when the read fails.
  "legacy": [
    // An IPv4 service.
    { "raw": "00000000000000000000ffff01020304270f", "read": 18, "written": "00000000000000000000ffff01020304270f", "entries": ["1.2.3.4:9999"], "empty": false },
    // The unset service is empty.
    { "raw": "000000000000000000000000000000000000", "read": 18, "written": "000000000000000000000000000000000000", "entries": [], "empty": true },
    // An IPv6 service.
    { "raw": "26064700470000000000000000001111270f", "read": 18, "written": "26064700470000000000000000001111270f", "entries": ["[2606:4700:4700::1111]:9999"], "empty": false },
    // A valid address on port 0 is kept.
    { "raw": "00000000000000000000ffff010203040000", "read": 18, "written": "00000000000000000000ffff010203040000", "entries": ["1.2.3.4:0"], "empty": false },
    // An IPv6 address in fc00::/8 is valid.
    { "raw": "fc000000000000000000000000000001270f", "read": 18, "written": "fc000000000000000000000000000001270f", "entries": ["[fc00::1]:9999"], "empty": false },
    // A service without its whole port is refused.
    { "raw": "00000000000000000000ffff0102030427", "read": null, "written": null, "entries": null, "empty": null },
