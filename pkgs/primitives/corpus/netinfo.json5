  // Each vector reads the network info of a version 3 provider payload from `raw`. `read` counts the bytes read, `written` is the value written back, `entries` the address and port of every entry, group by group, and `empty` whether the value is empty. Fields other than `raw` are null when the read fails.
  "extended": [
    // One core P2P group.
    { "raw": "0101000101010401020304270f", "read": 13, "written": "0101000101010401020304270f", "entries": ["1.2.3.4:9999"], "empty": false },
    // A group for each purpose, in purpose order.
    { "raw": "0103000101010401020304270f01010101040102030468200201020b6578616d706c652e636f6d01bb", "read": 41, "written": "0103000101010401020304270f01010101040102030468200201020b6578616d706c652e636f6d01bb", "entries": ["1.2.3.4:9999", "1.2.3.4:26656", "example.com:443"], "empty": false },
    // Two entries in one group.
    { "raw": "0101000201010401020304270f01010405060708270f", "read": 22, "written": "0101000201010401020304270f01010405060708270f", "entries": ["1.2.3.4:9999", "5.6.7.8:9999"], "empty": false },
    // Five entries in one group are read; the limit of 4 is a check.
    { "raw": "0101000501010401020304270f01010405060708270f010104090a0b0c270f0101040d0e0f10270f01010411121314270f", "read": 49, "written": "0101000501010401020304270f01010405060708270f010104090a0b0c270f0101040d0e0f10270f01010411121314270f", "entries": ["1.2.3.4:9999", "5.6.7.8:9999", "9.10.11.12:9999", "13.14.15.16:9999", "17.18.19.20:9999"], "empty": false },
    // No groups is empty.
    { "raw": "0100", "read": 2, "written": "0100", "entries": [], "empty": true },
    // Of an unsupported version, 0 or above 1, only the version is read and written back. The value is not empty.
    // https://github.com/dashpay/dash/blob/v24.0.0-rc.4/src/evo/netinfo.h#L409-L424
    // https://github.com/dashpay/dash/blob/v24.0.0-rc.4/src/evo/netinfo.h#L443
    // Version 0.
    { "raw": "00", "read": 1, "written": "00", "entries": [], "empty": false },
    // Version 2.
    { "raw": "02", "read": 1, "written": "02", "entries": [], "empty": false },
    // Version 2, before a group that is not read.
    { "raw": "0201000101010401020304270f", "read": 1, "written": "02", "entries": [], "empty": false },
    // Version 0xff.
    { "raw": "ff", "read": 1, "written": "ff", "entries": [], "empty": false },
    // A purpose must be known and above the purpose before it, or the whole value is refused.
    // https://github.com/dashpay/dash/blob/v24.0.0-rc.4/src/evo/netinfo.h#L425-L435
    // A group of an unknown purpose is refused.
    { "raw": "0102000101010401020304270f030101010405060708270f", "read": null, "written": null, "entries": null, "empty": null },
    // Groups out of purpose order are refused.
    { "raw": "01020201020b6578616d706c652e636f6d01bb000101010401020304270f", "read": null, "written": null, "entries": null, "empty": null },
    // A repeated purpose is refused.
    { "raw": "0102000101010401020304270f000101010405060708270f", "read": null, "written": null, "entries": null, "empty": null },
    // A purpose repeated after another is refused.
    { "raw": "0103000101010401020304270f0101010104010203046820000101010405060708270f", "read": null, "written": null, "entries": null, "empty": null },
    // An unknown purpose before a known one is refused.
    { "raw": "0102030101010405060708270f000101010401020304270f", "read": null, "written": null, "entries": null, "empty": null },
    // A purpose repeated after an empty group is refused.
    { "raw": "01020000000101010401020304270f", "read": null, "written": null, "entries": null, "empty": null },
    // The read stops after the last group.
    { "raw": "0100ff", "read": 2, "written": "0100", "entries": [], "empty": true },
    // An empty input is refused.
    { "raw": "", "read": null, "written": null, "entries": null, "empty": null },
    // A version without a group count is refused.
    { "raw": "01", "read": null, "written": null, "entries": null, "empty": null },
    // A group without an entry count is refused.
    { "raw": "010100", "read": null, "written": null, "entries": null, "empty": null },
    // A group count past the input is refused.
    { "raw": "0102000101010401020304270f", "read": null, "written": null, "entries": null, "empty": null },
    // A domain of 254 bytes refuses the whole value.
    { "raw": "", "read": null, "written": null, "entries": null, "empty": null },
    // An entry of unknown type is invalid and the next entry is read.
    { "raw": "010100020001010401020304270f", "read": 14, "written": "01010002ff01010401020304270f", "entries": ["[invalid entry]", "1.2.3.4:9999"], "empty": false },
    // One empty group is not empty.
    { "raw": "01010000", "read": 4, "written": "01010000", "entries": [], "empty": false },
    // A domain entry that is too long or cut short refuses the whole value.
    // https://github.com/dashpay/dash/blob/v24.0.0-rc.4/src/evo/netinfo.h#L253-L261
    // A domain of 254 bytes before a service is refused.
    { "raw": "", "read": null, "written": null, "entries": null, "empty": null },
    // A domain length of 65535 is refused.
    { "raw": "0101000102fdffff616263", "read": null, "written": null, "entries": null, "empty": null },
    // A domain shorter than its length is refused.
    { "raw": "01010001021461616161616161616161", "read": null, "written": null, "entries": null, "empty": null },
    // A domain with a short port is refused.
    { "raw": "01010001020b6578616d706c652e636f6d01", "read": null, "written": null, "entries": null, "empty": null },
    // A domain with an empty label is an invalid entry, and the next entry is read.
    // https://github.com/dashpay/dash/blob/v24.0.0-rc.4/src/evo/netinfo.cpp#L105-L107
    // https://github.com/dashpay/dash/blob/v24.0.0-rc.4/src/evo/netinfo.h#L261
    { "raw": "010100020204612e2e6201bb01010401020304270f", "read": 21, "written": "01010002ff01010401020304270f", "entries": ["[invalid entry]", "1.2.3.4:9999"], "empty": false },
    // After a service that fails to read, the next entry is read from where the service read stopped.
    // https://github.com/dashpay/dash/blob/v24.0.0-rc.4/src/evo/netinfo.h#L247-L252
    // An IPv4 address size of 3.
    { "raw": "0101000201010301010401020304270f", "read": 16, "written": "01010002ff01010401020304270f", "entries": ["[invalid entry]", "1.2.3.4:9999"], "empty": false },
    // An IPv4 address size of 3, whose next byte is read as the next entry.
    { "raw": "01010002010103ff", "read": 8, "written": "01010002ffff", "entries": ["[invalid entry]", "[invalid entry]"], "empty": false },
    // An oversized address on an unknown network.
    { "raw": "010100020107fd010201010401020304270f", "read": 18, "written": "01010002ff01010401020304270f", "entries": ["[invalid entry]", "1.2.3.4:9999"], "empty": false },
    // An IPv4 address cut short, whose one remaining byte is read as the next entry.
    { "raw": "01010002010104ff", "read": 8, "written": "01010002ffff", "entries": ["[invalid entry]", "[invalid entry]"], "empty": false },
    // A short port, in the last entry.
    { "raw": "010100010101040102030427", "read": 11, "written": "01010001ff", "entries": ["[invalid entry]"], "empty": false },
  ],
}
