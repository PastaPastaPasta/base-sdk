             {0, {0, 1}, 2, {1}, 0, 0},
         }) {
        const auto size = [&](size_t pad) { return ::GetSerializeSize(BuildTx(s, pad), PROTOCOL_VERSION); };
        size_t pad{0};
        while (s.target && size(pad) != s.target) {
            pad = pad + s.target - size(pad);
        }
        const CTransaction tx{BuildTx(s, pad)};
        TxValidationState state;
        CheckTransaction(tx, state);
        std::printf("    { \"type\": %u, \"inputs\": [", s.type);
