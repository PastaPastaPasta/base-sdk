//
// Context-free transaction check vectors. Generated with the reference
// implementation (dashpay/dash v24.0.0-rc.3, 0364ed626e).
//
// Each vector describes a version 3 transaction. `inputs` holds one seed per
// input, where 0 is the null outpoint and any other seed spends output 0 of
// the hash filled with that byte. Input 0 has a `script_sig` of that many
// zero bytes, output 0 has a script of `pad` zero bytes, the other scripts
// are empty, and the payload is `payload` zero bytes. `size` is the
// serialized size and `reason` the rejection reason, empty when the
// transaction passes.
//
// To run the program, paste it at the end of the `transaction_tests` suite in
// `src/test/transaction_tests.cpp` at the specified revision, build it with
// `make -C src test/test_dash` and run
// `./src/test/test_dash --run_test=transaction_tests/tx_check_shapes`. The
// output should match the section.
//

{
/*

struct TxShape {
    uint16_t type;
    std::vector<uint8_t> inputs;
    size_t script_sig;
    std::vector<CAmount> values;
    size_t payload;
    size_t target;
};

static CMutableTransaction BuildTx(const TxShape& s, size_t pad)
{
    CMutableTransaction tx;
    tx.nVersion = 3;
    tx.nType = s.type;
    for (const uint8_t seed : s.inputs) {
        COutPoint prevout;
        if (seed) {
            uint256 hash;
            std::fill(hash.begin(), hash.end(), seed);
            prevout = COutPoint{hash, 0};
        }
        tx.vin.emplace_back(prevout);
    }
    if (!tx.vin.empty()) tx.vin[0].scriptSig.resize(s.script_sig);
    for (const CAmount value : s.values) {
        tx.vout.emplace_back(value, CScript{});
    }
    if (!tx.vout.empty()) tx.vout[0].scriptPubKey.resize(pad);
    tx.vExtraPayload.resize(s.payload);
    return tx;
}

BOOST_AUTO_TEST_CASE(tx_check_shapes)
{
    for (const TxShape& s : std::vector<TxShape>{
