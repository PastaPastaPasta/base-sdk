            std::printf("], \"lock_time\": %u, \"sigops\": %zu, \"pad\": %zu }", txs[i].lock_time, txs[i].sigops,
                        txs[i].pad);
        }
        std::printf("], \"merkle_root\": \"%s\", \"size\": %zu, \"reason\": \"%s\" },\n",
                    block.hashMerkleRoot.ToString().c_str(), ::GetSerializeSize(block, PROTOCOL_VERSION),
                    state.GetRejectReason().c_str());
