  // Each vector holds the V2 contents the reference transport sends once
  // the version both peers share is set to `version`, for each message type
  // with an empty payload: a short ID, or a zero byte and the 12-byte command.
  "v2_send": [
    // Until a version is agreed, every message takes the long format.
    {
      "version": 209,
      "contents": {
        "version": "0076657273696f6e0000000000",
        "verack": "0076657261636b000000000000",
        "addr": "00616464720000000000000000",
        "addrv2": "00616464727632000000000000",
        "sendaddrv2": "0073656e646164647276320000",
        "inv": "00696e76000000000000000000",
        "getdata": "00676574646174610000000000",
        "merkleblock": "006d65726b6c65626c6f636b00",
        "getblocks": "00676574626c6f636b73000000",
        "getheaders": "00676574686561646572730000",
        "tx": "00747800000000000000000000",
        "headers": "00686561646572730000000000",
        "block": "00626c6f636b00000000000000",
        "getaddr": "00676574616464720000000000",
        "mempool": "006d656d706f6f6c0000000000",
        "ping": "0070696e670000000000000000",
        "pong": "00706f6e670000000000000000",
