BOOST_AUTO_TEST_CASE(v2_recv)
{
    std::vector<uint8_t> rest(CMessageHeader::COMMAND_SIZE + 8, 0x07);
    std::fill_n(rest.begin(), CMessageHeader::COMMAND_SIZE, 0);
    std::copy_n("ping", 4, rest.begin());
    for (int id = 0; id <= 0xff; ++id) {
        V2TransportTester tester(true);
        auto ret = tester.Interact();
        BOOST_REQUIRE(ret && ret->empty());
        tester.SendKey();
        tester.SendGarbage();
        tester.ReceiveKey();
        tester.SendGarbageTerm();
        tester.SendVersion();
        ret = tester.Interact();
        BOOST_REQUIRE(ret && ret->empty());
        tester.ReceiveGarbage();
        tester.ReceiveVersion();
        std::vector<uint8_t> contents{static_cast<uint8_t>(id)};
        contents.insert(contents.end(), rest.begin(), rest.end());
        tester.SendPacket(contents);
        ret = tester.Interact();
        BOOST_REQUIRE(ret && ret->size() == 1);
        const auto& msg{(*ret)[0]};
        if (msg) {
            std::printf("    { \"byte\": %d, \"type\": \"%s\", \"size\": %u },\n", id, msg->m_type.c_str(),
                        static_cast<unsigned>(msg->m_message_size));
        } else {
            std::printf("    { \"byte\": %d, \"type\": null },\n", id);
        }
    }
}
*/
  // Each vector holds a first byte of V2 contents, followed by a long-form
  // `ping` type and an 8-byte payload, with the type the reference transport
  // reads and the size of the payload it passes on. A null type: the
  // transport reads no type.
