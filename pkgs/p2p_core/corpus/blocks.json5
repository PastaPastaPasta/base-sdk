/*
#include <iostream>
#include <tinyformat.h>
#include <util/strencodings.h>

static CMutableTransaction CorpusTx(int i) {
    CMutableTransaction tx;
    tx.nVersion = i + 1;
    tx.nLockTime = 17 + i;
    tx.vin.emplace_back(COutPoint(uint256::ONE, 3 + i), CScript{} << OP_TRUE, 42 + i);
    tx.vout.emplace_back(1234 + i, CScript{} << OP_RETURN);
    return tx;
}
static std::string CorpusTxJson(int i) {
    return strprintf("{\"version\":%d,\"txType\":0,\"inputs\":[{\"prevout\":{\"hash\":\"%s\",\"index\":%d},\"scriptSig\":\"51\",\"sequence\":%d}],\"outputs\":[{\"value\":%d,\"scriptPubKey\":\"6a\"}],\"lockTime\":%d,\"extraPayload\":\"\"}",
                     i + 1, uint256::ONE.ToString(), 3 + i, 42 + i, 1234 + i, 17 + i);
}
static CBlockHeader CorpusHeader() {
    CBlockHeader h;
    h.nVersion = 4;
    h.hashPrevBlock = uint256::ONE;
    h.hashMerkleRoot = uint256::TWO;
    h.nTime = 123456789;
    h.nBits = 0x207fffff;
    h.nNonce = 12345;
    return h;
}
static std::string CorpusHeaderJson() {
    return strprintf("{\"version\":4,\"prevHash\":\"%s\",\"merkleRoot\":\"%s\",\"time\":123456789,\"bits\":545259519,\"nonce\":12345}", uint256::ONE.ToString(), uint256::TWO.ToString());
}

