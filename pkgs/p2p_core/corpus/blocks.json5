        CBlock block;
        static_cast<CBlockHeader&>(block) = CorpusHeader();
        for (int j = 0; j <= i; ++j) block.vtx.push_back(MakeTransactionRef(CorpusTx(j)));
        wire << block;
        const auto details = strprintf("{\"header\":%s,\"transactions\":[%s%s]}", CorpusHeaderJson(), CorpusTxJson(0), i ? "," + CorpusTxJson(1) : "");
        std::cout << strprintf("    \"case%d\": {\"raw\":\"%s\",\"details\":%s}%s\n", i, HexStr(wire), details, i == 1 ? "" : ",");
    }
    std::cout << strprintf("  },\n");
}
*/
