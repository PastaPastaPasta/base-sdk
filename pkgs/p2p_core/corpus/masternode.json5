                             size_t{CPubKey::COMPACT_SIGNATURE_SIZE} + 1}) {
        std::vector<unsigned char> raw;
        CVectorWriter{SER_NETWORK, PROTOCOL_VERSION, raw, 0}
            << SPORK_2_INSTANTSEND_ENABLED << SporkValue{1} << int64_t{2} << std::vector<unsigned char>(len, 0x30);
        bool read{true};
        try {
            CSporkMessage spork;
            CDataStream{raw, SER_NETWORK, PROTOCOL_VERSION} >> spork;
        } catch (const std::ios_base::failure&) {
            read = false;
        }
        std::printf("    { \"raw\": \"%s\", \"sig_len\": %zu, \"read\": %s },\n", HexStr(raw).c_str(), len,
