BOOST_AUTO_TEST_CASE(platformban_payloads)
{
    CBLSSecretKey sk;
    BOOST_REQUIRE(sk.SetHexStr("0505050505050505050505050505050505050505050505050505050505050505", false));
    struct Case {
        std::string label;
        uint256 pro_tx_hash;
        int32_t requested_height;
        uint256 quorum_hash;
        CBLSSignature sig;
    };
    for (const auto& [label, pro_tx_hash, requested_height, quorum_hash, sig] : std::vector<Case>{
             {"null", uint256{}, 0, uint256{}, CBLSSignature{}},
             {"signed", uint256::ONE, 1000, uint256::TWO, sk.Sign(uint256::ONE, false)},
             {"max_height", uint256S("00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"),
              std::numeric_limits<int32_t>::max(), Params().GenesisBlock().GetHash(), sk.Sign(uint256::TWO, false)},
             {"negative_height", uint256::TWO, -1, uint256::ONE, sk.Sign(uint256::ONE, false)}}) {
        PlatformBanMessage ban;
        ban.m_protx_hash = pro_tx_hash;
        ban.m_requested_height = requested_height;
        ban.m_quorum_hash = quorum_hash;
        ban.m_signature = sig;
        const auto msg{CNetMsgMaker{PROTOCOL_VERSION}.Make(NetMsgType::PLATFORMBAN, ban)};
        PlatformBanMessage read;
        CDataStream{msg.data, SER_NETWORK, PROTOCOL_VERSION} >> read;
        BOOST_REQUIRE(read.GetHash() == ban.GetHash() && read.m_signature == sig);
        std::printf("    \"%s\": {\n      \"raw\": \"%s\",\n      \"details\": {\n"
                    "        \"pro_tx_hash\": \"%s\",\n        \"requested_height\": %d,\n"
                    "        \"quorum_hash\": \"%s\",\n        \"sig\": \"%s\"\n      }\n    },\n",
                    label.c_str(), HexStr(msg.data).c_str(), pro_tx_hash.ToString().c_str(), requested_height,
                    quorum_hash.ToString().c_str(), HexStr(sig.ToBytes(false)).c_str());
    }
}
