/*
#include <key.h>
#include <spork.h>

BOOST_AUTO_TEST_CASE(spork_payloads)
{
    CKey key;
    const std::vector<uint8_t> secret(32, 0x04);
    key.Set(secret.begin(), secret.end(), true);
    struct Case {
        std::string label;
        SporkId id;
        SporkValue value;
        int64_t time_signed;
        bool sign;
    };
    for (const auto& [label, id, value, time_signed, sign] : std::vector<Case>{
             {"unsigned", SPORK_2_INSTANTSEND_ENABLED, 0, 0, false},
             {"signed", SPORK_19_CHAINLOCKS_ENABLED, 4070908800, 1700000000, true},
             {"signed_wide", SPORK_INVALID, -2, 5000000000, true},
             {"negative_time", SPORK_23_QUORUM_POSE, 1, -1700000000, true}}) {
        CSporkMessage spork{id, value, NodeClock::time_point{std::chrono::seconds{time_signed}}};
        if (sign) BOOST_REQUIRE(spork.Sign(key));
        const auto msg{CNetMsgMaker{PROTOCOL_VERSION}.Make(NetMsgType::SPORK, spork)};
        CSporkMessage read;
        CDataStream{msg.data, SER_NETWORK, PROTOCOL_VERSION} >> read;
        BOOST_REQUIRE(read.GetHash() == spork.GetHash());
        // The signature follows its one-byte length at offset 20.
        BOOST_REQUIRE_EQUAL(size_t{msg.data.at(20)}, msg.data.size() - 21);
        std::printf("    \"%s\": {\n      \"raw\": \"%s\",\n      \"details\": {\n        \"spork_id\": %d,\n"
                    "        \"value\": %lld,\n        \"time_signed\": %lld,\n        \"sig\": \"%s\"\n"
                    "      }\n    },\n",
                    label.c_str(), HexStr(msg.data).c_str(), static_cast<int>(id), (long long)value,
                    (long long)time_signed, HexStr(Span{msg.data}.subspan(21)).c_str());
    }
}
*/
