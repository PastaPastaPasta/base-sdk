    BOOST_REQUIRE(sk.SetHexStr("0303030303030303030303030303030303030303030303030303030303030303", false));
    struct Case {
        std::string label;
        uint256 pro_reg_tx_hash;
        CBLSSignature sig;
    };
    for (const auto& [label, pro_reg_tx_hash, sig] : std::vector<Case>{
             {"null", uint256{}, CBLSSignature{}},
             {"signed", uint256::ONE, sk.Sign(uint256::ONE, false)},
             {"signed_hash", uint256S("00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"),
              sk.Sign(uint256::TWO, false)}}) {
        CMNAuth mnauth;
        mnauth.proRegTxHash = pro_reg_tx_hash;
        mnauth.sig = sig;
        const auto msg{CNetMsgMaker{PROTOCOL_VERSION}.Make(NetMsgType::MNAUTH, mnauth)};
        CMNAuth read;
        CDataStream{msg.data, SER_NETWORK, PROTOCOL_VERSION} >> read;
        BOOST_REQUIRE(read.proRegTxHash == pro_reg_tx_hash && read.sig == sig);
        std::printf("    \"%s\": {\n      \"raw\": \"%s\",\n      \"details\": {\n"
                    "        \"pro_reg_tx_hash\": \"%s\",\n        \"sig\": \"%s\"\n      }\n    },\n",
                    label.c_str(), HexStr(msg.data).c_str(), pro_reg_tx_hash.ToString().c_str(),
                    HexStr(sig.ToBytes(false)).c_str());
    }
    bls::bls_legacy_scheme.store(legacy);
}
