            CDataStream flags{SER_NETWORK, PROTOCOL_VERSION};
            flags << w.flags;
            flags >> header.bit_field;
            header.nVersion = w.version;
            header.hashPrevBlock = genesis.GetHash();
            header.hashMerkleRoot = ArithToUint256(arith_uint256{uint64_t{headers.size() + 1}});
            header.nTime = w.time;
            header.time_offset = w.time_offset;
            header.nBits = w.bits;
            header.nNonce = headers.size();
            headers.push_back(header);
        }
        return CNetMsgMaker{PROTOCOL_VERSION}.Make(NetMsgType::HEADERS2, headers).data;
    };
    const int32_t a{0x20000000};
    const uint32_t t{genesis.nTime};
    const uint32_t b{genesis.nBits};
