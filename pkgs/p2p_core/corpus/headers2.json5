        {{0xf8, a, t, 0, b}, {0xc1, 0, 0, 150, 0}, {0x41, 0, 0, 150, 0}},
        {{0x10, a, t, 0, 0}, {0x01, 0, 0, 150, 0}},
        {{0x38, a, 5, 0, b}, {0x01, 0, 0, -10, 0}, {0x31, 0, 0xffffffff, 0, b}, {0x01, 0, 0, 1, 0}},
        {{0x38, a, t, 0, b}, {0x00, a + 1, 0, 1, 0}, {0x00, a + 2, 0, 1, 0}, {0x00, a + 3, 0, 1, 0},
         {0x00, a + 4, 0, 1, 0}, {0x00, a + 5, 0, 1, 0}, {0x00, a + 6, 0, 1, 0}, {0x00, a + 7, 0, 1, 0},
