{
    const CBlockHeader genesis{Params().GenesisBlock().GetBlockHeader()};
    const auto chain = [&](const std::vector<std::tuple<int32_t, int64_t, uint32_t>>& steps) {
        std::vector<CBlockHeader> headers;
        for (const auto& [version, time_step, bits] : steps) {
            const CBlockHeader& prev{headers.empty() ? genesis : headers.back()};
            CBlockHeader header;
            header.nVersion = version;
            header.hashPrevBlock = prev.GetHash();
            header.hashMerkleRoot = ArithToUint256(arith_uint256{uint64_t{headers.size() + 1}});
            header.nTime = static_cast<uint32_t>(prev.nTime + time_step);
            header.nBits = bits;
            header.nNonce = headers.size();
            headers.push_back(header);
        }
        return headers;
    };
    const auto reply = [](const std::vector<CBlockHeader>& headers) {
        std::list<int32_t> last_unique_versions;
        std::vector<CompressibleBlockHeader> v_headers;
        for (const CBlockHeader& block : headers) {
            CompressibleBlockHeader compressible_header{CBlockHeader{block}};
            if (!v_headers.empty()) compressible_header.Compress(v_headers, last_unique_versions);
            v_headers.emplace_back(compressible_header);
        }
        return CNetMsgMaker{PROTOCOL_VERSION}.Make(NetMsgType::HEADERS2, v_headers).data;
    };
    const auto announce = [](const std::vector<CBlockHeader>& headers) {
        std::list<int32_t> last_unique_versions;
        std::vector<CompressibleBlockHeader> vHeadersCompressed;
        for (const CBlockHeader& block : headers) {
            CompressibleBlockHeader compressible_header{CBlockHeader{block}};
            compressible_header.Compress(vHeadersCompressed, last_unique_versions);
            vHeadersCompressed.push_back(compressible_header);
        }
        return CNetMsgMaker{PROTOCOL_VERSION}.Make(NetMsgType::HEADERS2, vHeadersCompressed).data;
    };
    const auto uncompress = [](const std::vector<unsigned char>& raw) {
        CDataStream stream{raw, SER_NETWORK, PROTOCOL_VERSION};
        std::vector<CBlockHeader> headers;
        std::list<int32_t> last_unique_versions;
        for (unsigned int n = ReadCompactSize(stream); n > 0; --n) {
            CompressibleBlockHeader block_header_compressed;
            stream >> block_header_compressed;
            block_header_compressed.Uncompress(headers, last_unique_versions);
            headers.push_back(block_header_compressed);
        }
        BOOST_CHECK(stream.empty());
        return headers;
    };
    const uint32_t bits{genesis.nBits};
    const std::vector<int32_t> v{0x20000000, 0x20000001, 0x20000002, 0x20000004, 0x20000008,
                                 0x20000010, 0x20000020, 0x20000040, 0x20000080};
    const std::vector<std::vector<CBlockHeader>> chains{
        chain({{v[0], 150, bits}}),
        chain({{v[0], 150, bits}, {v[0], 150, bits}}),
        chain({{v[0], 150, bits}, {v[0], 150, bits}, {v[1], 150, bits}, {v[0], 150, bits}, {v[2], 150, bits},
               {v[3], 150, bits}, {v[4], 150, bits}, {v[5], 150, bits}, {v[6], 150, bits}, {v[7], 150, bits},
               {v[8], 150, bits}, {v[0], 150, bits}, {v[1], 150, bits}, {v[8], 150, bits}, {v[2], 150, bits}}),
        chain({{v[0], 150, bits}, {v[0], 1, bits}, {v[0], 0, bits - 1}, {v[0], -1, bits - 1}, {v[0], 32767, bits},
               {v[0], -32768, bits}, {v[0], 32768, bits}, {v[0], -32769, bits - 1}, {v[0], 600, bits}}),
        chain({{v[0], -int64_t{genesis.nTime} - 10, bits}, {v[0], 20, bits}, {v[0], -20, bits}}),
    };
    const auto print = [&](const char* name, const auto& compress) {
        std::printf("  \"%s\": [\n", name);
        for (const auto& headers : chains) {
            const auto raw{compress(headers)};
            const auto restored{uncompress(raw)};
            BOOST_CHECK(restored.size() == headers.size());
            std::printf("    {\n      \"headers\": [\n");
            for (size_t i = 0; i < headers.size(); ++i) {
                const CBlockHeader& h{headers[i]};
                BOOST_CHECK(restored[i].GetHash() == h.GetHash());
                std::printf("        { \"version\": %d, \"prevHash\": \"%s\", \"merkleRoot\": \"%s\", \"time\": %u, "
                            "\"bits\": %u, \"nonce\": %u },\n",
                            h.nVersion, h.hashPrevBlock.GetHex().c_str(), h.hashMerkleRoot.GetHex().c_str(), h.nTime,
                            h.nBits, h.nNonce);
            }
            std::printf("      ],\n      \"raw\": \"%s\"\n    },\n", HexStr(raw).c_str());
        }
        std::printf("  ],\n");
    };
    print("reply", reply);
    print("announce", announce);
}
