        {{0x39, a, t, 0, b}, {0x01, 0, 0, 150, 0}},
        {{0x28, a, 0, 600, b}, {0x01, 0, 0, 1, 0}},
        {{0x01, 0, 0, 600, 0}, {0x01, 0, 0, 1, 0}},
        {{0x38, a, t, 0, b}, {0x02, 0, 0, 150, 0}, {0x01, 0, 0, 150, 0}, {0x03, 0, 0, 150, 0}},
        {{0x01, 0, 0, 600, 0}, {0x00, a, 0, 1, 0}, {0x02, 0, 0, 1, 0}, {0x02, 0, 0, 1, 0}},
        {{0x38, a, t, 0, b}, {0x00, a + 1, 0, 1, 0}, {0x03, 0, 0, 1, 0}, {0x01, 0, 0, 1, 0}},
    };
    for (const auto& wire : cases) {
        const auto raw{payload(wire)};
        CDataStream stream{raw, SER_NETWORK, PROTOCOL_VERSION};
        std::vector<CBlockHeader> headers;
        std::vector<CompressibleBlockHeader> received;
