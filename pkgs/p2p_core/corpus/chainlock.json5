//
// To run a program, paste it at the end of the `net_tests` suite in
// `src/test/net_tests.cpp` at the specified revision, include `bls/bls.h` and
// `chainlock/chainlock.h` there, build it with `make -C src test/test_dash`
// and run `./src/test/test_dash --run_test=net_tests/<name>`. The output
// should match the section.
//

