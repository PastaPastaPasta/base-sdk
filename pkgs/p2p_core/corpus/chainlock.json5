#include <bls/bls.h>
#include <chainlock/chainlock.h>

BOOST_AUTO_TEST_CASE(clsig_payloads)
{
    const bool legacy{bls::bls_legacy_scheme.exchange(false)};
    CBLSSecretKey sk;
    BOOST_REQUIRE(sk.SetHexStr("0101010101010101010101010101010101010101010101010101010101010101", false));
    struct Case {
        std::string label;
        int32_t height;
        uint256 block_hash;
        CBLSSignature sig;
    };
    for (const auto& [label, height, block_hash, sig] : std::vector<Case>{
             {"null", -1, uint256{}, CBLSSignature{}},
             {"genesis", 0, Params().GenesisBlock().GetHash(), sk.Sign(uint256::ONE, false)},
             {"max_height", std::numeric_limits<int32_t>::max(),
              uint256S("00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"),
              sk.Sign(uint256::TWO, false)}}) {
        const auto msg{CNetMsgMaker{PROTOCOL_VERSION}.Make(NetMsgType::CLSIG,
                                                           chainlock::ChainLockSig{height, block_hash, sig})};
        chainlock::ChainLockSig read;
        CDataStream{msg.data, SER_NETWORK, PROTOCOL_VERSION} >> read;
        BOOST_REQUIRE(read.getHeight() == height && read.getBlockHash() == block_hash && read.getSig() == sig);
        std::printf("    \"%s\": {\n      \"raw\": \"%s\",\n      \"details\": {\n        \"height\": %d,\n"
                    "        \"block_hash\": \"%s\",\n        \"sig\": \"%s\"\n      }\n    },\n",
                    label.c_str(), HexStr(msg.data).c_str(), height, block_hash.ToString().c_str(),
                    HexStr(sig.ToBytes(false)).c_str());
    }
    bls::bls_legacy_scheme.store(legacy);
}
