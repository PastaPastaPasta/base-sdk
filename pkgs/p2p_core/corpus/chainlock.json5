/*
#include <bls/bls.h>
#include <instantsend/lock.h>

BOOST_AUTO_TEST_CASE(isdlock_payloads)
{
    CBLSSecretKey sk;
    BOOST_REQUIRE(sk.SetHexStr("0202020202020202020202020202020202020202020202020202020202020202", false));
    struct Case {
        std::string label;
        uint8_t version;
        std::vector<COutPoint> inputs;
        uint256 txid;
        uint256 cycle_hash;
        CBLSSignature sig;
    };
    const uint256 hash{uint256S("00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff")};
    for (const auto& [label, version, inputs, txid, cycle_hash, sig] : std::vector<Case>{
             {"one_input", 1, {COutPoint{uint256::ONE, 0}}, uint256::TWO, Params().GenesisBlock().GetHash(),
              sk.Sign(uint256::ONE, false)},
             {"three_inputs", 1,
              {COutPoint{uint256::ONE, 1}, COutPoint{uint256::TWO, 0x01020304},
               COutPoint{hash, std::numeric_limits<uint32_t>::max()}},
              hash, uint256::ONE, sk.Sign(uint256::TWO, false)},
             {"version_255_no_inputs", 255, {}, uint256{}, uint256{}, CBLSSignature{}}}) {
        instantsend::InstantSendLock islock;
        islock.nVersion = version;
        islock.inputs = inputs;
        islock.txid = txid;
        islock.cycleHash = cycle_hash;
        islock.sig.Set(sig, false);
        const auto msg{CNetMsgMaker{PROTOCOL_VERSION}.Make(NetMsgType::ISDLOCK, islock)};
        instantsend::InstantSendLock read;
        CDataStream{msg.data, SER_NETWORK, PROTOCOL_VERSION} >> read;
        BOOST_REQUIRE(::SerializeHash(read) == ::SerializeHash(islock));
        std::printf("    \"%s\": {\n      \"raw\": \"%s\",\n      \"details\": {\n        \"version\": %u,\n"
                    "        \"inputs\": [",
                    label.c_str(), HexStr(msg.data).c_str(), version);
        for (size_t i = 0; i < inputs.size(); ++i) {
            std::printf("%s{ \"hash\": \"%s\", \"index\": %u }", i ? ", " : "",
                        inputs[i].hash.ToString().c_str(), inputs[i].n);
        }
        std::printf("],\n        \"txid\": \"%s\",\n        \"cycle_hash\": \"%s\",\n        \"sig\": \"%s\"\n"
                    "      }\n    },\n",
                    txid.ToString().c_str(), cycle_hash.ToString().c_str(), HexStr(sig.ToBytes(false)).c_str());
    }
}
*/
