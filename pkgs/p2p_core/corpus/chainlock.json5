/*
#include <instantsend/lock.h>

BOOST_AUTO_TEST_CASE(isdlock_input_limit)
{
    constexpr size_t max_inputs{instantsend::InstantSendLock::MAX_INPUTS};
    for (const size_t count : {max_inputs, max_inputs + 1}) {
        instantsend::InstantSendLock islock;
        for (uint32_t i = 0; i < count; ++i) {
            islock.inputs.emplace_back(uint256::ONE, i);
        }
        islock.txid = uint256::TWO;
        const auto msg{CNetMsgMaker{PROTOCOL_VERSION}.Make(NetMsgType::ISDLOCK, islock)};
        instantsend::InstantSendLock read;
        CDataStream{msg.data, SER_NETWORK, PROTOCOL_VERSION} >> read;
        BOOST_REQUIRE_EQUAL(read.inputs.size(), count);
        std::printf("    {\n      \"max_inputs\": %zu,\n      \"version\": %u,\n      \"inputs\": %zu,\n"
                    "      \"input_hash\": \"%s\",\n      \"txid\": \"%s\",\n      \"cycle_hash\": \"%s\",\n"
                    "      \"size\": %zu,\n      \"hash\": \"%s\"\n    },\n",
                    max_inputs, read.nVersion, count, uint256::ONE.ToString().c_str(), read.txid.ToString().c_str(),
                    read.cycleHash.ToString().c_str(), msg.data.size(), ::SerializeHash(read).ToString().c_str());
    }
}
*/
