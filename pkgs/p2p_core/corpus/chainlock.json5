BOOST_AUTO_TEST_CASE(clsig_payloads)
{
    // Testnet height 1,591,597, block hash 00000033c02bc0c9db6c29eace7eebaca13d42048964ba3dd3054d97f8765d96, from getbestchainlock.
    constexpr char CLSIG_LIVE[] =
        "2d491800965d76f8974d05d33dba648904423da1aceb7eceea296cdbc9c02bc033000000acdf465f86507649eb3937ff932dd94a6b98a8295eac689b6fb2be65ac9f379489f8c2257f7d028cbe66e03e9ac9c56f021638327790564052d827b4455848f2d600f79c459f6d419c7026501436a6cee091bdd6d5543f2710abd25e27cbbe32";
    const bool legacy{bls::bls_legacy_scheme.exchange(false)};
    std::printf("  \"clsig\": {\n");
    const auto print = [](const char* label, const CSerializedNetMsg& message) {
        DataStream fields{message.data};
        chainlock::ChainLockSig clsig;
        fields >> clsig;
        DataStream sig{};
        sig << clsig.getSig();
        std::printf("    \"%s\": {\n      \"raw\": \"%s\",\n      \"details\": {\n        \"height\": %d,\n"
                    "        \"block_hash\": \"%s\",\n        \"sig\": \"%s\"\n      }\n    },\n",
                    label, HexStr(message.data).c_str(), clsig.getHeight(), clsig.getBlockHash().ToString().c_str(),
                    HexStr(sig).c_str());
    };
    const CNetMsgMaker maker{PROTOCOL_VERSION};
    CBLSSecretKey sk;
    BOOST_REQUIRE(sk.SetHexStr("0101010101010101010101010101010101010101010101010101010101010101", false));
    print("null", maker.Make(NetMsgType::CLSIG, chainlock::ChainLockSig{-1, uint256{}, CBLSSignature{}}));
    print("max_height", maker.Make(NetMsgType::CLSIG,
                                   chainlock::ChainLockSig{std::numeric_limits<int32_t>::max(),
                                                           uint256S("00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"),
                                                           sk.Sign(uint256::TWO, false)}));
    DataStream live(ParseHex(CLSIG_LIVE));
    chainlock::ChainLockSig clsig;
    live >> clsig;
    print("testnet_one", maker.Make(NetMsgType::CLSIG, clsig));
    std::printf("  },\n");
    bls::bls_legacy_scheme.store(legacy);
}
*/
