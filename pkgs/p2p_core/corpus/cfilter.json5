/*
static BlockFilter FilterOf(const std::vector<CScript>& scripts)
{
    CMutableTransaction tx;
    for (const CScript& script : scripts) tx.vout.emplace_back(100, script);
    CBlock block;
    block.vtx.push_back(MakeTransactionRef(tx));
    return BlockFilter(BlockFilterType::BASIC_FILTER, block, CBlockUndo{});
}

static const std::vector<CScript> FILTER_SCRIPTS{
    CScript() << OP_DUP << OP_HASH160 << std::vector<unsigned char>(20, 1) << OP_EQUALVERIFY << OP_CHECKSIG,
    CScript() << OP_HASH160 << std::vector<unsigned char>(20, 2) << OP_EQUAL,
    CScript() << OP_1 << std::vector<unsigned char>(33, 3) << OP_1 << OP_CHECKMULTISIG,
};
