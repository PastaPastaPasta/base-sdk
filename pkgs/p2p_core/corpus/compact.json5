    const std::vector<std::vector<uint64_t>> lists{{65535}, {65536}, {65534, 0}, {65535, 0}, {2, 65533}};
    for (size_t i = 0; i < lists.size(); ++i) {
        DataStream wire;
        wire << uint256::TWO;
        WriteCompactSize(wire, lists[i].size());
        uint64_t sum{0};
        for (const auto diff : lists[i]) { WriteCompactSize(wire, diff); sum += diff + 1; }
        const std::string raw = HexStr(wire);
        bool accepted{true};
        try { BlockTransactionsRequest read; wire >> read; } catch (const std::ios_base::failure&) { accepted = false; }
        std::cout << strprintf("    {\"sum\":%llu,\"raw\":\"%s\",\"accepted\":%s}%s\n", (unsigned long long)(sum - 1), raw, accepted ? "true" : "false", i == lists.size() - 1 ? "" : ",");
    }
    std::cout << strprintf("  ],\n");
}
