#include <hash.h>

BOOST_AUTO_TEST_CASE(corpus_combined_count_limit_payloads)
{
    std::cout << strprintf("  \"combined_count_limit\": [\n");
    const std::vector<std::pair<size_t, size_t>> counts{{65535, 0}, {65536, 0}, {65534, 1}, {65535, 1}, {0, 65535}, {0, 65536}};
    for (size_t i = 0; i < counts.size(); ++i) {
        const auto [shorts, full] = counts[i];
        DataStream wire;
        wire << CorpusHeader() << uint64_t{0x0102030405060708};
        WriteCompactSize(wire, shorts);
        for (size_t j = 0; j < shorts; ++j) { uint64_t id{0x123456789abc}; wire << Using<CustomUintFormatter<6>>(id); }
        wire << std::vector<PrefilledTransaction>(full, PrefilledTransaction{0, MakeTransactionRef(CorpusTx(0))});
        const size_t size = wire.size();
        const auto hash = Hash(wire);
        bool accepted{true};
        try { CBlockHeaderAndShortTxIDs read; wire >> read; } catch (const std::ios_base::failure&) { accepted = false; }
