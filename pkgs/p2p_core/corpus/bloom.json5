        return s;
    };
    CBloomFilter all(3, 0.01, 0, BLOOM_UPDATE_ALL);
    all.insert(ParseHex("99108ad8ed9bb6274d3980bab5a85c048f0950c8"));
    all.insert(ParseHex("b5a2c786d9ef4658287ced5914b37a1b4aa32eee"));
    print("update_all", make(all));
    CBloomFilter p2pubkey(2, 0.001, 2147483649UL, BLOOM_UPDATE_P2PUBKEY_ONLY);
    p2pubkey.insert(ParseHex("045b81f0017e2091e2edcd5eecf10d5bdd120a5514cb3ee65b8447ec18bfc4575c6d5bf415e54e03b1067934a0f0ba76b01c6b9ab227142ee1d543764b69d901e0"));
    print("update_p2pubkey_only", make(p2pubkey));
    print("empty", make(CBloomFilter{}));
    // Hash function count past the relay limit and a flags byte past two,
    // both read as they are.
    DataStream unchecked{};
    unchecked << std::vector<unsigned char>{0xa5} << uint32_t{MAX_HASH_FUNCS + 1} << uint32_t{7} << uint8_t{0xff};
    CBloomFilter read;
    unchecked >> read;
    print("unchecked", make(read));
}
*/
  "filterload": {
    "update_all": {
      "raw": "0341449a050000000000000001",
      "details": {
        "filter": "41449a",
        "hash_funcs": 5,
        "tweak": 0,
        "flags": 1
      }
    },
    "update_p2pubkey_only": {
      "raw": "03350c21080000000100008002",
      "details": {
        "filter": "350c21",
        "hash_funcs": 8,
        "tweak": 2147483649,
        "flags": 2
      }
    },
    "empty": {
      "raw": "00000000000000000000",
      "details": {
        "filter": "",
        "hash_funcs": 0,
        "tweak": 0,
        "flags": 0
      }
    },
    // Pins a hash function count past the relay limit and a flags byte past two, both read as they are.
    "unchecked": {
      "raw": "01a53300000007000000ff",
      "details": {
        "filter": "a5",
        "hash_funcs": 51,
        "tweak": 7,
        "flags": 255
      }
    },
  },
