        std::printf("    \"%s\": {\n      \"raw\": \"%s\",\n      \"details\": {\n"
                    "        \"filter\": \"%s\",\n        \"hash_funcs\": %u,\n"
                    "        \"tweak\": %u,\n        \"flags\": %u\n      }\n    },\n",
