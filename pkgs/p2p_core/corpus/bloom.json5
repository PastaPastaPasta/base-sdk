  "filterload": {
    // Pins a non-empty filter with update-all flags.
    "update_all": {
      "raw": "0341449a050000000000000001",
      "details": {
        "filter": "41449a",
        "hash_funcs": 5,
        "tweak": 0,
        "flags": 1
      }
    },
    // Pins a non-empty filter with pubkey-only flags and a high tweak.
    "update_p2pubkey_only": {
      "raw": "03350c21080000000100008002",
      "details": {
        "filter": "350c21",
        "hash_funcs": 8,
        "tweak": 2147483649,
        "flags": 2
      }
    },
    // Pins an empty filter and zero scalar fields.
    "empty": {
      "raw": "00000000000000000000",
      "details": {
        "filter": "",
        "hash_funcs": 0,
        "tweak": 0,
        "flags": 0
      }
    },
    // Pins a hash function count past the relay limit and a flags byte past two, both read as they are.
    "unchecked": {
      "raw": "01a53300000007000000ff",
      "details": {
        "filter": "a5",
        "hash_funcs": 51,
        "tweak": 7,
        "flags": 255
      }
    },
  },
