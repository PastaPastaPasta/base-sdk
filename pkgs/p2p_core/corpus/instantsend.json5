BOOST_AUTO_TEST_CASE(isdlock_payloads)
{
    // Testnet txid a42dba55ba7e5561be87da57f597bb8532eb3f2f9b939310bc8c2c892aa10748, one input, from getislocks.
    constexpr char ISDLOCK_LIVE_ONE[] =
        "";
    // Testnet txid c4fa855ceefd0afe02391591962f316eafd9a9c8537b0340762eff9706ca8bfd, 16 inputs, from getislocks.
    constexpr char ISDLOCK_LIVE_MANY[] =
        "";
    const bool legacy{bls::bls_legacy_scheme.exchange(false)};
    std::printf("  \"isdlock\": {\n");
    const auto print = [](const char* label, const CSerializedNetMsg& message) {
        DataStream fields{message.data};
        instantsend::InstantSendLock lock;
        fields >> lock;
        DataStream sig{};
        sig << lock.sig;
        std::printf("    \"%s\": {\n      \"raw\": \"%s\",\n      \"details\": {\n        \"version\": %u,\n"
                    "        \"inputs\": [",
                    label, HexStr(message.data).c_str(), lock.nVersion);
        for (size_t i = 0; i < lock.inputs.size(); ++i) {
            std::printf("%s{ \"hash\": \"%s\", \"index\": %u }", i ? ", " : "",
                        lock.inputs[i].hash.ToString().c_str(), lock.inputs[i].n);
        }
        std::printf("],\n        \"txid\": \"%s\",\n        \"cycle_hash\": \"%s\",\n        \"sig\": \"%s\"\n"
                    "      }\n    },\n",
                    lock.txid.ToString().c_str(), lock.cycleHash.ToString().c_str(), HexStr(sig).c_str());
    };
    const auto read = [](const char* raw) {
        DataStream input(ParseHex(raw));
        instantsend::InstantSendLock lock;
        input >> lock;
        return lock;
    };
    const CNetMsgMaker maker{PROTOCOL_VERSION};
    instantsend::InstantSendLock empty;
    empty.nVersion = 255;
    empty.sig.Set(CBLSSignature{}, false);
    print("version_255_no_inputs", maker.Make(NetMsgType::ISDLOCK, empty));
    print("testnet_one_input", maker.Make(NetMsgType::ISDLOCK, read(ISDLOCK_LIVE_ONE)));
    print("testnet_many_inputs", maker.Make(NetMsgType::ISDLOCK, read(ISDLOCK_LIVE_MANY)));
    std::printf("  },\n");
    bls::bls_legacy_scheme.store(legacy);
}
*/
