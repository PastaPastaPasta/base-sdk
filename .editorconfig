root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.Dockerfile]
indent_size = 4

[*.bat]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[{Justfile,*.just}]
indent_size = 4

[{*.bzl,*.bazel}]
indent_size = 4

# A blank context line in a patch is a single space, which the format needs.
[*.patch]
trim_trailing_whitespace = false
