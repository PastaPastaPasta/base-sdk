# The output root is placed in `.cache` (see `bazel/shim.py`), and the repo contents cache cannot live in-tree.
common --repo_contents_cache=

# Keeps the convenience symlinks out of the repository root.
build --symlink_prefix=.cache/bazel-

# The pinned LLVM toolchain is the only C toolchain. Bazel would otherwise
# also configure whatever compiler the host offers.
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1

# Only `just zglock` rewrites the lock; a stale one fails everywhere else, so
# no host Bazel can quietly change what CI then trusts.
common --lockfile_mode=error

# A build script that fetched would make every pin advisory.
build --nosandbox_default_allow_network

# Reusing sandbox directories skips most input staging.
build --reuse_sandbox_directories

# Fixed directories let the devshell and a plain shell share one action cache.
# They exist on POSIX hosts only, so a Windows host keeps its own PATH.
common --enable_platform_specific_config
build:linux --action_env=PATH=/usr/bin:/bin:/usr/sbin:/sbin
build:macos --action_env=PATH=/usr/bin:/bin:/usr/sbin:/sbin

# A failed action prints its full command line.
build --verbose_failures

# Per-developer settings, ignored by git.
try-import %workspace%/.bazelrc.user
