# macOS targets, native builds included, compile against the SDK extracted
# from Xcode 26.1.1 (17B100).

xcode_sdk = use_repo_rule("//bazel:darwin.bzl", "xcode_sdk")

xcode_sdk(
    name = "macos_sdk",
    # `toolchains_llvm` links Foundation into every Darwin binary, and
    # Foundation re-exports CoreFoundation.
    frameworks = [
        "CoreFoundation",
        "Foundation",
    ],
    sdk_version = "26.1",
    sha256 = "9600fa93644df674ee916b5e2c8a6ba8dacf631996a65dc922d003b98b5ea3b1",
    strip_prefix = "Xcode-26.1.1-17B100-extracted-SDK-with-libcxx-headers",
    urls = ["https://bitcoincore.org/depends-sources/sdks/Xcode-26.1.1-17B100-extracted-SDK-with-libcxx-headers.tar"],
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.sysroot(
    label = "@macos_sdk//:sysroot",
    targets = [
        "darwin-aarch64",
        "darwin-x86_64",
    ],
)
