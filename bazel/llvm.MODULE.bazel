# Every target compiles C and C++ against a pinned sysroot, the host's
# included, so no artifact depends on what the builder has installed.

single_version_override(
    module_name = "toolchains_llvm",
    patch_strip = 1,
    patches = [
        # Clang takes the SDK version a macOS binary records from `-isysroot`
        # alone, which 1.8.0 does not pass.
        "//bazel/patches:toolchains_llvm-darwin-sdk-version.patch",
        # 1.8.0 keys its Darwin handling on the exec and target platforms
        # together, so a Linux host targeting macOS gets ELF flags, the
        # wrong libc++ and no libtool.
        "//bazel/patches:toolchains_llvm-darwin-target.patch",
        # 1.8.0 has no MinGW target.
        "//bazel/patches:toolchains_llvm-windows-target.patch",
    ],
)

# lld is not ld64, and clang gates linker flags on the ld64 release it is told
# to expect. Clang built for Linux otherwise assumes an ancient one.
LD64_VERSION = "711"

# 20.1.3 matches the devshell's LLVM. It and 20.1.7 are the newest releases
# with an archive for every supported host.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    extra_link_flags = {
        "darwin-aarch64": ["-mlinker-version=" + LD64_VERSION],
        "darwin-x86_64": ["-mlinker-version=" + LD64_VERSION],
    },
    # GCC's driver adds the pthread library MinGW's libstdc++ needs, and clang
    # does not. Named in full, as rustc does, so the static archive wins over
    # the DLL import library.
    extra_link_libs = {
        "windows-x86_64": ["-l:libpthread.a"],
    },
    # Replaces the macOS compiler-rt with one carrying every architecture.
    libclang_rt = {
        "@macos_compiler_rt//:lib/clang/20/lib/darwin/libclang_rt.osx.a": "darwin/libclang_rt.osx.a",
    },
    llvm_version = "20.1.3",
    # The Debian sysroots carry libstdc++ as a shared library only, and the
    # MinGW one links it statically, so no DLL has to travel with a binary.
    stdlib = {
        "linux-aarch64": "dynamic-stdc++",
        "linux-x86_64": "dynamic-stdc++",
        "windows-x86_64": "stdc++",
    },
)
use_repo(llvm, "llvm_toolchain", "llvm_toolchain_llvm")

# Registered by the root module, the LLVM toolchain outranks any C toolchain
# a dependency module registers.
register_toolchains("@llvm_toolchain//:all")
