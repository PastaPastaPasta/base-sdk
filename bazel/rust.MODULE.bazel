# Build scripts read the target's codegen flags as cargo hands them over, which
# 0.73.0 does not do.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//bazel/patches:rules_rust-build-script-target-flags.patch"],
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

# An empty `versions` stops rules_rust registering a toolchain for its own
# default release.
rust.toolchain(
    extra_target_triples = [],
    versions = [],
)
